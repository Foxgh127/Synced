# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.sites-dev.*.log

# env files (can opt-in for committing if needed)
.env*
!/native/deployment/.env.low-bandwidth.example
/native/deployment/secrets/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# native application build outputs
/native/node_modules/
/native/dist-renderer/
/native/release/
/native/reports/
/native/.toolchains/
/native/audio-helper/bin/
/native/audio-helper/obj/
/native/audio-helper/publish/
/native/vendor/ffmpeg-*.zip
/native/vendor/ffmpeg/ffmpeg.exe
/native/.tmp-*/
/native/android/.gradle/
/native/android/build/
/native/android/app/build/
/native/android/local.properties
*.jks
*.keystore
keystore.properties
