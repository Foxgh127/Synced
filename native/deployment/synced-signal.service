[Unit]
Description=Synced WebRTC signaling service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=synced
Group=synced
WorkingDirectory=/opt/synced
EnvironmentFile=/etc/synced-signal.env
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node /opt/synced/synced-signal.mjs
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=15
UMask=0077
StateDirectory=synced/segment-relay
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/synced/segment-relay
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
MemoryHigh=448M
TasksMax=64

[Install]
WantedBy=multi-user.target
