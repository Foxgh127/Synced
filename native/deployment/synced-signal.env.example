PORT=8787
HOST=127.0.0.1
MAX_VIEWERS_PER_ROOM=7
ICE_SERVERS_JSON='[{"urls":["stun:43.161.195.12:3478"]}]'
TURN_URLS='turn:43.161.195.12:3478?transport=udp,turn:43.161.195.12:3478?transport=tcp'
TURN_SECRET_FILE=/etc/synced-turn.secret
TURN_TCP_ENABLED=true
TURN_CREDENTIAL_TTL_SECONDS=2700
SFU_ENABLED=true
SFU_TOKEN_TTL_SECONDS=2700
SFU_PUBLIC_URL=wss://synced.com.cn/sfu
LIVEKIT_API_KEY=synced_sfu
LIVEKIT_API_SECRET_FILE=/etc/synced-livekit.secret
SEGMENT_RELAY_SECRET_FILE=/etc/synced-segment-relay.secret
SEGMENT_RELAY_CACHE_DIR=/var/lib/synced/segment-relay
SEGMENT_RELAY_MEMORY_BYTES=100663296
SEGMENT_RELAY_ROOM_MEMORY_BYTES=50331648
SEGMENT_RELAY_ROOM_DISK_BYTES=1073741824
SEGMENT_RELAY_ROOM_OBJECTS=20000
SEGMENT_RELAY_ROOM_ACTIVE_RENDITIONS=3
SEGMENT_RELAY_ROOM_UPLOAD_BPS=134217728
# Optional hard override. When omitted, the relay uses 4% of available disk
# space, capped at 5 GiB.
# SEGMENT_RELAY_DISK_BYTES=5368709120
SIGNAL_NODE_ID=hk-edge-primary
SIGNAL_REGION=ap-hongkong
ALLOWED_ORIGINS=file://,http://localhost,https://localhost,capacitor://localhost,tauri://localhost,https://tauri.localhost
ALLOW_NO_ORIGIN=false
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ALLOW_LEGACY_PROTOCOL=false
MAX_CLIENTS=128
MAX_CLIENTS_PER_IP=64
MAX_MESSAGES_PER_MINUTE=3600
READINESS_EXTERNAL_PROBES=true
SIGNAL_MAX_BUFFERED_BYTES=786432
