PUBLIC_IP=203.0.113.10
TURN_REALM=room.example.com
TURN_SECRET_FILE=./secrets/turn_secret
# List both UDP and TCP endpoints; TURN_TCP_ENABLED must be true to forward TCP
# URLs to clients (coturn always listens on both protocols on port 3478).
TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
# Set to true to include TCP TURN URLs in ICE server lists sent to clients.
# TCP relay helps clients behind firewalls that block UDP (corporate networks).
TURN_TCP_ENABLED=true
TURN_CREDENTIAL_TTL_SECONDS=14400
# TURN and SFU intentionally have no configured bandwidth ceiling. Congestion
# control follows real endpoint/network capacity instead of a server-side cap.
SFU_ENABLED=true
SFU_PUBLIC_URL=wss://room.example.com/sfu
LIVEKIT_API_KEY=synced_sfu
LIVEKIT_API_SECRET_FILE=./secrets/livekit_api_secret
SEGMENT_RELAY_SECRET_FILE=./secrets/segment_relay_secret
SEGMENT_RELAY_MEMORY_BYTES=100663296
SEGMENT_RELAY_DISK_BYTES=5368709120
SIGNAL_NODE_ID=hk-edge-primary
SIGNAL_REGION=ap-hongkong
MAX_CLIENTS=128
MAX_CLIENTS_PER_IP=16
MAX_MESSAGES_PER_MINUTE=600
SIGNAL_MAX_BUFFERED_BYTES=786432
ALLOWED_ORIGINS=file://,http://localhost,https://localhost,capacitor://localhost
ALLOW_NO_ORIGIN=true
