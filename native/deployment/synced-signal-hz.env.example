PORT=8787
HOST=127.0.0.1
MAX_VIEWERS_PER_ROOM=7
# The Hangzhou host runs signalling only. All ICE media services stay on the
# Tencent primary node.
ICE_SERVERS_JSON='[{"urls":["stun:43.161.195.12:3478"]}]'
TURN_URLS='turn:43.161.195.12:3478?transport=udp,turn:43.161.195.12:3478?transport=tcp'
# Must contain the same REST secret used by coturn on 43.161.195.12.
TURN_SECRET_FILE=/etc/synced-turn.secret
TURN_TCP_ENABLED=true
TURN_CREDENTIAL_TTL_SECONDS=14400
SFU_ENABLED=true
SFU_PUBLIC_URL=wss://synced.com.cn/sfu
LIVEKIT_API_KEY=synced_sfu
LIVEKIT_API_SECRET_FILE=/etc/synced-livekit.secret
SIGNAL_NODE_ID=hz-signal-standby
SIGNAL_REGION=cn-hangzhou
ALLOWED_ORIGINS=file://,http://localhost,https://localhost,capacitor://localhost,tauri://localhost,https://tauri.localhost
ALLOW_NO_ORIGIN=true
TRUST_PROXY=true
ALLOW_LEGACY_PROTOCOL=false
MAX_CLIENTS=96
MAX_CLIENTS_PER_IP=12
MAX_MESSAGES_PER_MINUTE=600
SIGNAL_MAX_BUFFERED_BYTES=786432
